<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="helloDialog"
        title="Hello"
        contentWidth="50%"
    >
        <Table
            id="idTbl"
            growing="true"
            growingThreshold="20"
            items="{Prod>/ProductCollection}"
        >
            <columns>
                <Column>
                    <Text text='Product ID' />
                </Column>
                <Column>
                    <Text text='Category' />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    type="Active"
                    press="onPressRow"
                >
                    <cells>
                        <Text text="{Prod>ProductId}" />
                        <Text text="{Prod>Category}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    text="Close"
                    type="Reject"
                    icon="sap-icon://decline"
                    press="onCloseDialog"
                />
            </OverflowToolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>
